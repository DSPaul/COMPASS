<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="COMPASS.Tests.UI.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <avalonia:MaterialIconStyles />
        <StyleInclude Source="avares://COMPASS.Common/Themes/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://COMPASS.Common/Themes/Constants.axaml" />
                <ResourceInclude Source="avares://COMPASS.Common/Themes/Dark.axaml" />
                <ResourceInclude Source="avares://COMPASS.Common/Themes/Converters.axaml" />
                <ResourceInclude Source="avares://COMPASS.Common/Themes/CustomControls.axaml" />
                <ResourceInclude Source="avares://COMPASS.Common/Themes/ContextMenus.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>