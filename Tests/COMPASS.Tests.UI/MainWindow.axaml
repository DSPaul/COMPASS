<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:COMPASS.Tests.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="COMPASS.Tests.UI.MainWindow"
        Title="COMPASS.Tests.UI" x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto *" 
          RowDefinitions="Auto,*" 
          Margin="20" ColumnSpacing="10" RowSpacing="10">
        <Button Grid.Column="0" Grid.Row="0" Content="Open Progress Window" Command="{Binding OpenProgressWindowCommand}"/>
        <Button Grid.Column="1" Grid.Row="0" Content="Open Info Window" Command="{Binding OpenInfoWindowCommand}"/>
        <Button Grid.Column="2" Grid.Row="0" Content="Open Warning Window" Command="{Binding OpenWarningWindowCommand}"/>
        <Button Grid.Column="3" Grid.Row="0" Content="Open Error Window" Command="{Binding OpenErrorWindowCommand}"/>
        <Button Grid.Column="4" Grid.Row="0" Content="Open Loading Window" Command="{Binding OpenLoadingWindowCommand}"/>
    </Grid>
</Window>
