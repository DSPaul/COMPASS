<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>COMPASS</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
    <!-- Both are referenced unconditionally to keep the lock file identical for every RID;
         each only ships runtimes/<rid>/native, so publish picks the one matching the target RID. -->
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64.slim" Version="5.0.0.20261109" />
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-arm64.slim" Version="5.0.0.20261109" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\COMPASS.Common\COMPASS.Common.csproj" />
    <ProjectReference Include="..\COMPASS.Infra\COMPASS.Infra.csproj" />
  </ItemGroup>
</Project>
