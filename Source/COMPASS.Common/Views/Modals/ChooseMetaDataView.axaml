<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:COMPASS.Common.ViewModels.Modals"
             xmlns:model="using:COMPASS.Common.Models"
             xmlns:controls="using:COMPASS.Common.Controls"
             xmlns:conv="using:COMPASS.Infra.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="COMPASS.Common.Views.Modals.ChooseMetadataView"
             x:DataType="vm:ChooseMetadataViewModel"
             MinHeight="400" Width="800">
    <Grid RowDefinitions="auto,auto,*,auto">
        <DockPanel Margin="40,10" >
            <DockPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Light"/>
                </Style>
            </DockPanel.Styles>
            <TextBlock HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Run Text="{Binding StepCounter, Mode=OneWay, Converter={StaticResource PlusOneConverter}}"/>
                / 
                <Run Text="{Binding MetadataProposals.Count, Mode=OneTime}"/>
            </TextBlock>
            <TextBlock DockPanel.Dock="Bottom">
                Current Item: 
                <Run Text="{Binding CurrentProposal.ExistingMetadata.Title, Mode=OneWay}" 
                     Foreground="{StaticResource AccentColorMuted}"/>
            </TextBlock>
            <TextBlock>
                There are
                <Run Text="{Binding MetadataProposals.Count, Mode=OneTime}"/>
                items with conflicts to resolve.
            </TextBlock>
        </DockPanel>
        <ProgressBar Grid.Row="1" 
                     Value="{Binding StepCounter, Mode=OneWay, Converter={StaticResource PlusOneConverter}}"
                     Maximum="{Binding MetadataProposals.Count, Mode=OneTime}" 
                     Margin="10,0"
                     Background="{StaticResource UIElementBackground}"/>
        <Border BorderBrush="{StaticResource DarkUIElementBackground}" Margin="10" BorderThickness="2"
                Grid.Row="2" CornerRadius="5" Padding="10">
            <Border.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="20,5"/>
                </Style>
            </Border.Styles>
            <ScrollViewer DataContext="{Binding CurrentProposal}">
                <Grid ColumnDefinitions="auto,auto,*,10,*"
                        RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto">
                    <Rectangle Grid.Column="1" Fill="{StaticResource Separator}" Width="3" Margin="20,5" Grid.RowSpan="100"/>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Metadata Type"/>
                    <TextBlock Text="Current Value" Grid.Row="0" Grid.Column="2"/>
                    <TextBlock Text="Newly Found Value" Grid.Row="0" Grid.Column="4"/>

                    <Rectangle Grid.Row="1" Fill="{StaticResource Separator}" Height="3" Margin="20,5" Grid.ColumnSpan="5"
                                Grid.Column="0" />
                                
                    <TextBlock Text="Title:" Grid.Row="2" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Title}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Title]}" Grid.Column="2" Grid.Row="2" Classes="WrapText"
                                    Content="{Binding ExistingMetadata.Title}" 
                                    IsChecked="{Binding !ShouldUseNewValue[Title].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Title}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Title]}" Grid.Column="4" Grid.Row="2" Classes="WrapText"
                                    Content="{Binding ProposedMetadata.Title}" 
                                    IsChecked="{Binding ShouldUseNewValue[Title].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Title}"/>

                    <TextBlock Text="Authors:" Grid.Row="3" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Authors}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Authors]}" Grid.Column="2" Grid.Row="3" Classes="WrapText"
                                    Content="{Binding ExistingMetadata.AuthorsAsString}" 
                                    IsChecked="{Binding !ShouldUseNewValue[Authors].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Authors}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Authors]}" Grid.Column="4" Grid.Row="3" Classes="WrapText"
                                    Content="{Binding ProposedMetadata.AuthorsAsString}" 
                                    IsChecked="{Binding ShouldUseNewValue[Authors].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Authors}"/>

                    <TextBlock Text="Publisher:" Grid.Row="4" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Publisher}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Publisher]}" Grid.Column="2" Grid.Row="4" Classes="WrapText"
                                    Content="{Binding ExistingMetadata.Publisher}" 
                                    IsChecked="{Binding !ShouldUseNewValue[Publisher].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Publisher}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Publisher]}" Grid.Column="4" Grid.Row="4" Classes="WrapText"
                                    Content="{Binding ProposedMetadata.Publisher}" 
                                    IsChecked="{Binding ShouldUseNewValue[Publisher].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Publisher}"/>

                    <TextBlock Text="Version:" Grid.Row="5" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Version}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Version]}" Grid.Column="2" Grid.Row="5"
                                    Content="{Binding ExistingMetadata.Version}" 
                                    IsChecked="{Binding !ShouldUseNewValue[Version].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Version}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Version]}" Grid.Column="4" Grid.Row="5" 
                                    Content="{Binding ProposedMetadata.Version}" 
                                    IsChecked="{Binding ShouldUseNewValue[Version].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Version}"/>

                    <TextBlock Text="Page count:" Grid.Row="6" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=PageCount}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[PageCount]}" Grid.Column="2" Grid.Row="6"
                                    Content="{Binding ExistingMetadata.PageCount}" 
                                    IsChecked="{Binding !ShouldUseNewValue[PageCount].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=PageCount}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[PageCount]}" Grid.Column="4" Grid.Row="6"
                                    Content="{Binding ProposedMetadata.PageCount}" 
                                    IsChecked="{Binding ShouldUseNewValue[PageCount].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=PageCount}"/>

                    <TextBlock Text="Description:" Grid.Row="7" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Description}" Margin="20,0,20,5" VerticalAlignment="Bottom"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Description]}" Grid.Column="2" Grid.Row="7" Classes="WrapText"
                                    Content="{Binding ExistingMetadata.Description}" 
                                    IsChecked="{Binding !ShouldUseNewValue[Description].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Description}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Description]}" Grid.Column="4" Grid.Row="7" Classes="WrapText"
                                    Content="{Binding ProposedMetadata.Description}" 
                                    IsChecked="{Binding ShouldUseNewValue[Description].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Description}"/>

                    <TextBlock Text="Release Date:" Grid.Row="8" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=ReleaseDate}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[ReleaseDate]}" Grid.Column="2" Grid.Row="8"
                                    IsChecked="{Binding !ShouldUseNewValue[ReleaseDate].Value, Mode=OneWay}"
                                    Content="{Binding ExistingMetadata.ReleaseDate, StringFormat=dd/mm/yyyy}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=ReleaseDate}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[ReleaseDate]}" Grid.Column="4" Grid.Row="8"
                                    IsChecked="{Binding ShouldUseNewValue[ReleaseDate].Value}"
                                    Content="{Binding ProposedMetadata.ReleaseDate, StringFormat=dd/mm/yyyy}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=ReleaseDate}"/>
                                
                    <TextBlock Text="Tags:" Grid.Row="8" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Tags}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Tags]}" Grid.Column="2" Grid.Row="8" 
                                    IsChecked="{Binding !ShouldUseNewValue[Tags].Value, Mode=OneWay}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Tags}">
                        <RadioButton.Content>
                            <ItemsControl Grid.Row="2" Grid.Column="0" Foreground="Black" Margin="3"
                                            ItemsSource="{Binding ExistingMetadata.Tags, Mode=OneWay}" 
                                            Background="{x:Null}" BorderBrush="{x:Null}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="model:Tag">
                                        <controls:Chip Text="{Binding Name}" Margin="0,3"
                                                        Background="{Binding BackgroundColor, Converter={x:Static conv:ColorConverters.ColorToBrush}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Tags]}" Grid.Column="4" Grid.Row="8" IsChecked="{Binding ShouldUseNewValue[Tags].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Tags}">
                        <RadioButton.Content>
                            <ItemsControl Grid.Row="2" Grid.Column="0" Foreground="Black" Margin="3"
                                    Background="{x:Null}" BorderBrush="{x:Null}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="model:Tag">
                                        <controls:Chip Text="{Binding Name}" Margin="0,3"
                                                        Background="{Binding BackgroundColor, Converter={x:Static conv:ColorConverters.ColorToBrush}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource CollectionUnionConverter}">
                                        <Binding Path="ExistingMetadata.Tags" Mode="OneWay" />
                                        <Binding Path="ProposedMetadata.Tags" Mode="OneWay" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </RadioButton.Content>
                    </RadioButton>

                    <TextBlock Text="Cover/Thumbnail:" Grid.Row="8" Grid.Column="0"
                                IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Cover}"/>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Cover]}" Grid.Column="2" Grid.Row="8" 
                                    IsChecked="{Binding !ShouldUseNewValue[Cover].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Cover}">
                        <RadioButton.Content>
                            <Image Source="{Binding ExistingMetadata.Cover}" Width="200"/>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton GroupName="{Binding MetadataChoiceGroupNames[Cover]}" Grid.Column="4" Grid.Row="8" IsChecked="{Binding ShouldUseNewValue[Cover].Value}"
                                    IsVisible="{Binding ProposedMetadata, Converter={StaticResource IsMetadataPropertyEmpty}, ConverterParameter=Cover}">
                        <RadioButton.Content>
                            <Image Source="{Binding ProposedMetadata.Cover}" Width="200"/>
                        </RadioButton.Content>
                    </RadioButton>
                </Grid>
            </ScrollViewer>
        </Border>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="3" Margin="10" Spacing="10">
            <controls:IconButton Content="Back" Command="{Binding PrevStepCommand}" Classes="HideIfDisabled"/>
            <controls:IconButton Content="Next" Command="{Binding NextStepCommand}" Classes="HideIfDisabled"/>
            <controls:IconButton Content="Finish" Command="{Binding FinishCommand}"
                                 Background="{StaticResource AccentColor}" Classes="HideIfDisabled" />
        </StackPanel>
    </Grid>
</UserControl>
