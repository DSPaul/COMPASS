<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:COMPASS.Common.ViewModels.Layouts"
             xmlns:modelVm="using:COMPASS.Common.ViewModels.ModelVMs"
             xmlns:behav="using:COMPASS.Infra.Avalonia.Behaviors"
             xmlns:dragdrop="using:COMPASS.Infra.Avalonia.DragDrop"
             xmlns:conv="using:COMPASS.Infra.Avalonia.Converters"
             xmlns:controls="using:COMPASS.Infra.Avalonia.Controls"
             xmlns:materialDesign="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CardLayoutViewModel"
             x:Class="COMPASS.Common.Views.Layouts.CardLayout">

    <ListBox x:Name="CardLayoutListBox"
             Background="Transparent"
             ItemsSource="{Binding FilteredCodexVms}"
             Margin="10,0" SelectionMode="Multiple"
             SelectedItem="{Binding SelectedCodex, Mode=OneWayToSource}"
             KeyDown="ListBox_KeyDown"
             behav:ContextMenuSelector.SingleSelectContextMenu="{StaticResource CodexContextMenu}"
             behav:ContextMenuSelector.MultiSelectContextMenu="{StaticResource MultiCodexContextMenu}"
             SelectionChanged="SelectedCodicesChanged">

        <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ClipToBounds" Value="False" />
                <Style Selector="^:selected">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColorMuted}" />
                </Style>
            </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:WrapGrid HorizontalContentAlignment="Center" ItemWidth="400"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="modelVm:CodexViewModel">
                <Border CornerRadius="5" Margin="20"
                        BorderThickness="3"
                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" 
                        DoubleTapped="Codex_DoubleTapped"
                        Classes="SmallZoomOnHover"
                        dragdrop:DropBehavior.IsDropTarget="True"
                        dragdrop:DropBehavior.DropManager="{Binding DropManager}">
                    <Border.Effect>
                        <DropShadowDirectionEffect BlurRadius="15" />
                    </Border.Effect>
                    <Border CornerRadius="5" 
                            Background="{StaticResource CardBackground}">
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Panel Grid.Column="0" ClipToBounds="True">
                                    <controls:RoundedImage Source="{Binding Thumbnail^, Mode=OneWay}"
                                            Stretch="UniformToFill" HorizontalAlignment="Center"
                                            Width="120"
                                            Height="{Binding Bounds.Height, ElementName=PropGrid}"
                                            CornerRadius="5,0,0,0"/>
                                    <Border VerticalAlignment="Bottom" Height="25"
                                            IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowFileIcons}">
                                        <Border.Background>
                                            <SolidColorBrush Color="Black" Opacity="0.3" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="25"
                                                Spacing="5" Margin="2, 0"
                                                IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowFileIcons}">
                                        <controls:IconButton Command="{Binding OpenCodexLocallyCommand}" ToolTip.Tip="Open Locally"
                                                             Background="Transparent" Classes="HideIfDisabled"
                                                             Theme="{StaticResource IconOnly}" Icon="FileOutline" />
                                        <controls:IconButton Command="{Binding OpenCodexOnlineCommand}" ToolTip.Tip="Open Online"
                                                             Background="Transparent" Classes="HideIfDisabled"
                                                             Theme="{StaticResource IconOnly}" Icon="Web" />
                                        <materialDesign:MaterialIcon Kind="Bookshelf" Margin="3"
                                                                     IsVisible="{Binding PhysicallyOwned}"
                                                                     ToolTip.Tip="Physically Owned" />
                                    </StackPanel>
                                </Panel>
                                <Border Grid.Column="1" x:Name="PropGrid" VerticalAlignment="Top" MinHeight="160">
                                    <DockPanel Margin="12,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Top" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextColor}"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Title}"
                                                       IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowTitle}" />

                                            <TextBlock Text="{Binding AuthorsAsString, StringFormat='By {0}'}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextMutedColor}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding AuthorsAsString, StringFormat='Authors: {0}'}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowAuthor" />
                                                        <Binding Path="AuthorsAsString" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>

                                            <TextBlock Text="{Binding ReleaseDateAsString}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedColor}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ReleaseDateAsString, StringFormat='Released: {0}'}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowReleaseDate" />
                                                        <Binding Path="ReleaseDateAsString" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>

                                            <Grid ColumnDefinitions="Auto,*">
                                                <Grid.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowPublisher" />
                                                        <Binding Path="Publisher" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                    </MultiBinding>
                                                </Grid.IsVisible>
                                                <materialDesign:MaterialIcon Grid.Column="0" Kind="Domain" Width="13" Height="13"
                                                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                                                             Foreground="{StaticResource TextMutedColor}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Publisher}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextMutedColor}"
                                                           VerticalAlignment="Center"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Publisher, StringFormat='Publisher: {0}'}" />
                                            </Grid>

                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedColor}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Version, StringFormat='Version: {0}'}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowVersion" />
                                                        <Binding Path="Version" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                        </StackPanel>

                                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <controls:RatingControl Grid.Column="0" Value="{Binding Rating}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                    ToolTip.Tip="{Binding Rating, StringFormat='{}{0} / 5'}"
                                                                    IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowRating}" />
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <controls:IconButton Command="{Binding FavoriteCodexCommand}" ToolTip.Tip="Favorite"
                                                                     Background="Transparent" Classes="SmallZoomOnHover"
                                                                     Theme="{StaticResource IconOnly}" Icon="HeartOutline" FontSize="16"
                                                                     IsVisible="{Binding !Favorite}" />
                                                <Button Command="{Binding FavoriteCodexCommand}" ToolTip.Tip="Unfavorite"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Classes="SmallZoomOnHover"
                                                        IsVisible="{Binding Favorite}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter Content="{TemplateBinding Content}" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <materialDesign:MaterialIcon Kind="Heart" Width="16" Height="16" Foreground="IndianRed" />
                                                </Button>
                                            </Panel>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Rectangle Fill="{StaticResource AccentColorMuted}" Height="3" 
                                       IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowTags}"/>
                            <Grid Margin="5,3" MinHeight="20"
                                  IsVisible="{Binding $parent[ListBox].((vm:CardLayoutViewModel)DataContext).Preferences.ShowTags}">
                                <ItemsControl Foreground="Black"
                                              ItemsSource="{Binding OrderedTags, Mode=OneWay}"
                                              Background="Transparent" BorderBrush="{x:Null}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="modelVm:TagViewModel">
                                            <controls:Chip
                                                Background="{Binding BackgroundColor, Converter={x:Static conv:ColorConverters.ColorToBrush}}"
                                                Text="{Binding Name}" Margin="2"
                                                ToolTip.Tip="{Binding LongName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No tags assigned" Margin="5 0"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{StaticResource TextMutedColor}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !OrderedTags.Count}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
