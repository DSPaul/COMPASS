<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bt="using:COMPASS.Common.Services.StateManagers"
        xmlns:specialConverters="using:COMPASS.Common.Converters"
        xmlns:controls="clr-namespace:COMPASS.Common.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="COMPASS.Common.Views.Windows.ProgressWindow"
        x:DataType="bt:TrackedOperation" WindowDecorations="None"
        Background="Transparent"
        Title="Progress Window" Height="250" Width="450" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <specialConverters:SeverityToColorConverter x:Key="SeverityToColorConverter" />
    </Window.Resources>
    <Border Background="{StaticResource WindowBackground}" CornerRadius="5" 
            BorderThickness="2" BorderBrush="{StaticResource PopupOutline}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"/>
        </Border.Effect>
        <Grid >
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="{Binding Title, Mode=OneWay, FallbackValue=Background task}"
                               FontSize="20" DockPanel.Dock="Left"/>
                    <controls:IconButton 
                        Icon="Close" Background="{StaticResource CancelFill}" 
                        ToolTip.Tip="Close"
                        Theme="{StaticResource IconOnly}" CornerRadius="3"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Close_Click" 
                        Width="20" Height="20"/>
                    <controls:IconButton 
                        Icon="CloseCircleOutline" Background="Transparent"
                        ToolTip.Tip="Cancel task"
                        Theme="{StaticResource IconOnly}" CornerRadius="3"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Cancel_Click" 
                        Width="20" Height="20"/>
                </DockPanel>
                <TextBlock Text="{Binding Tracker.StatusMessage, Mode=OneWay}" 
                           FontSize="14" Margin="0,2"/>
                <ProgressBar x:Name="ProgBar" Minimum="0" Maximum="100" 
                             Value="{Binding Tracker.Percentage, FallbackValue=0, Mode=OneWay}"
                             IsIndeterminate="{Binding Tracker.IsIndeterminate, Mode=OneWay}"
                                 Width="400" Margin="0,5"/>
                <Border Height="175" Width="400" Background="{StaticResource LogBackground}" 
                        CornerRadius="5" BorderBrush="{StaticResource LogBorder}" BorderThickness="1" Margin="0,5">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogsControl" BorderThickness="0" ItemsSource="{Binding Tracker.MessageLog, Mode=OneWay}" Margin="10,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Msg, FallbackValue=Message}" FontSize="12"  TextWrapping="Wrap"
                                               Foreground="{Binding Severity, Mode=OneWay,Converter={StaticResource SeverityToColorConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
