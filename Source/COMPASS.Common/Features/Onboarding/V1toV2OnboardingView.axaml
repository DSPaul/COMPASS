<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:COMPASS.Common.Features.Onboarding"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="380"
             x:Class="COMPASS.Common.Features.Onboarding.V1toV2OnboardingView"
             x:DataType="vm:V1toV2OnboardingVM"
             Width="600" MinHeight="380" Margin="20">
    <DockPanel Margin="30">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="Skip tour" Command="{Binding SkipCommand}"
                    IsVisible="{Binding !IsLastStep}" />
            <TextBlock Grid.Column="1" Text="{Binding StepCounterText}" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Content="Back" Command="{Binding PreviousCommand}" />
                <Button Content="Next" Command="{Binding NextCommand}" IsVisible="{Binding !IsLastStep}" />
                <Button Content="Got it" Command="{Binding NextCommand}" IsVisible="{Binding IsLastStep}" />
            </StackPanel>
        </Grid>

        <StackPanel VerticalAlignment="Center" Spacing="14" Margin="30,0">
            <materialIcons:MaterialIcon Kind="{Binding CurrentStep.Icon}" Width="56" Height="56"
                                        HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CurrentStep.Title}" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentStep.Description}"
                       TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</UserControl>
