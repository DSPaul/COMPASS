<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:COMPASS.Common.Features.Tools"
             xmlns:controls="using:COMPASS.Infra.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="COMPASS.Common.Features.Tools.ToolsView"
             x:DataType="vm:ToolsViewModel">
    <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:BackupToolViewModel">
                <UniformGrid Classes="ButtonStrip">
                    <controls:IconButton Content="Backup User Data..." Icon="FolderZip"
                                         Command="{Binding BackupLocalFilesCommand}"
                                         ToolTip.Tip="Saves all user data to a zip file"/>
                    <controls:IconButton Content="Restore Backup..." Icon="BackupRestore"
                                         Command="{Binding RestoreBackupCommand}"/>
                </UniformGrid>
            </DataTemplate>
            
            <DataTemplate x:DataType="vm:BrokenFileRefsToolViewModel">
                <vm:BrokenFileRefsToolView/>
            </DataTemplate>
        </ItemsControl.DataTemplates>
        
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="20"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:IToolViewModel">
                <Expander Header="{Binding Name}" HorizontalAlignment="Stretch">
                    <ContentControl Content="{Binding}"/>
                </Expander>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
