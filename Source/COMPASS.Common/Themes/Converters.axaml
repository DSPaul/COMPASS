<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:COMPASS.Infra.Avalonia.Converters"
                    xmlns:metadata="using:COMPASS.Common.Features.Metadata">
  <conv:MultiParamConverter x:Key="MultiParamConverter"/>
  <conv:AreEqualConverter Invert="False" x:Key="AreEqualConverter"/>
  <conv:AreEqualConverter Invert="True" x:Key="AreNotEqualConverter"/>
  <conv:IsSmallerOrEqualConverter x:Key="IsSmallerOrEqualConverter" />
  <conv:PlusOneConverter x:Key="PlusOneConverter" />
  <conv:EnumForRadioBtnConverter x:Key="EnumForRadioBtnConverter" />
  <conv:CollectionUnionConverter x:Key="CollectionUnionConverter" />
  <conv:SeverityToColorConverter x:Key="SeverityToColorConverter"/>
  <metadata:IsMetadataPropertyEmpty x:Key="IsMetadataPropertyEmpty" />
</ResourceDictionary>
